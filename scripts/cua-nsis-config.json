{
  "product_name": "Devices MCP",
  "install_dir": "%LOCALAPPDATA%\\Devices MCP",
  "operator_exe": "devices-mcp-native.exe",
  "backend_process_names": ["devices-mcp-native", "devices-mcp-backend", "devices-mcp-camera"],
  "backend_port": 10717,
  "service_name": "devices-mcp",
  "backend_timeout": 240,
  "frontend_timeout": 45,
  "frontend_port": 10716,
  "health_path": "/api/health",
  "diagnostics_path": "/api/v1/diagnostics",
  "feature_smoke_path": "/api/system/connection-health",
  "window_title_re": "Devices MCP",
  "nsis_glob": "native/target/release/bundle/nsis/Devices MCP_*_x64-setup.exe",
  "bridge_ok_text": "Devices MCP",
  "connected_badge_text": "online",
  "connected_timeout": 120,
  "backend_module": "schip_mcp_devices.server:app",
  "nav_routes": [
    ["Dashboard", "Dashboard"],
    ["Cameras", "Camera"],
    ["Energy", "Energy"],
    ["Weather", "Weather"],
    ["Log Management", "Log"],
    ["Lighting", "Lighting"],
    ["Robots", "Robot"],
    ["Ring Doorbell", "Ring"],
    ["Sensor Health", "Sensor"],
    ["Nest Protect", "Nest"],
    ["Status", "Status"],
    ["Human Health", "Health"],
    ["Alarms", "Alarm"],
    ["Messaging", "Messaging"],
    ["Onboarding", "Onboarding"],
    ["Chat", "Chat"],
    ["MCP Capabilities", "MCP"],
    ["Settings", "Settings"]
  ],
  "uninstall_registry_filter": "*Devices*",
  "log_file_paths": ["%LOCALAPPDATA%\\Devices MCP\\devices-mcp.log"]
}
