{
    "name": "devices-mcp",
    "version": "1.21.5",
    "type": "server",
    "runtime": "python",
    "entry_point": "src/devices_mcp/server_v2.py",
    "dependencies": [
        "fastmcp>=3.4.2",
        "pytapo>=3.3.0"
    ],
    "build": {
        "include": [
            "src/**/*",
            "README.md",
            "LICENSE",
            "pyproject.toml",
            "CHANGELOG.md",
            "config.yaml.example"
        ],
        "exclude": [
            "tests/",
            ".git/",
            "__pycache__/",
            "*.pyc",
            ".venv/",
            "dist/",
            "build/",
            "target/",
            "docs/",
            "scripts/",
            "mcpb/",
            "web-sota/",
            "node_modules/",
            "grafana/"
        ]
    },
    "scripts": {
        "build": "mcpb build",
        "pack": "mcpb pack . dist/devices-mcp.mcpb",
        "test": "uv run pytest"
    }
}
