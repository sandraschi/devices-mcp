{
  "productName": "Devices MCP",
  "version": "1.0.0",
  "identifier": "ai.fleet.devices-mcp",
  "build": {
    "frontendDist": "../web-sota/frontend/dist",
    "devUrl": "http://127.0.0.1:10716",
    "beforeDevCommand": "npm --prefix ../web-sota/frontend run dev",
    "beforeBuildCommand": "npm --prefix ../web-sota/frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Devices MCP",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/devices-mcp-camera", "binaries/devices-mcp-backend"]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "process": {
      "all": true
    }
  }
}
