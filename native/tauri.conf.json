{
  "productName": "Devices MCP",
  "version": "2.4.1",
  "identifier": "ai.fleet.devices-mcp",
  "build": {
    "frontendDist": "../web-sota/frontend/dist",
    "devUrl": "http://127.0.0.1:10716",
    "beforeDevCommand": "npm --prefix ../web-sota/frontend run dev",
    "beforeBuildCommand": "npm --prefix ../web-sota/frontend run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Devices MCP",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "url": "splash.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/devices-mcp-backend.exe",
      "resources/.env.example",
      "resources/devices-mcp-camera.exe"
    ],
    "targets": [
      "nsis"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "requireLiteralLeadingDot": false
    },
    "process": {
      "all": true
    }
  }
}

