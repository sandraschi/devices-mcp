# Devices MCP Environment Variables (EXAMPLE - copy to .env and fill in)
# MCP Server: Devices MCP (Unified IoT Hub)

# === Camera Credentials ===
TAPO_CAMERA_1_HOST=192.168.0.164
TAPO_CAMERA_1_USERNAME=sandraschi
TAPO_CAMERA_1_PASSWORD=your_password_here

TAPO_CAMERA_2_HOST=192.168.0.206
TAPO_CAMERA_2_USERNAME=sandraschi
TAPO_CAMERA_2_PASSWORD=your_password_here

# === Tapo P115 Smart Plug Account ===
TAPO_P115_EMAIL=your_email@example.com
TAPO_P115_PASSWORD=your_password_here

# === Tapo Lighting Account ===
TAPO_LIGHTING_EMAIL=your_email@example.com
TAPO_LIGHTING_PASSWORD=your_password_here

# === Ring Account (Doorbell + Alarm) ===
RING_EMAIL=your_ring_email@example.com
RING_PASSWORD=your_ring_password

# === Netatmo Weather ===
NETATMO_CLIENT_ID=6939e5b98080806f1c003668
NETATMO_CLIENT_SECRET=your_client_secret
NETATMO_REFRESH_TOKEN=your_refresh_token

# === Home Assistant ===
HA_URL=http://homeassistant.local:8123
HA_ACCESS_TOKEN=your_ha_long_lived_token

# === Robotics ===
DREAME_HOST=192.168.0.XXX
DREAME_TOKEN=your_token_here
YAHBOOM_HOST=192.168.1.11
YAHBOOM_MCP_URL=http://127.0.0.1:10892
DREAME_MCP_URL=http://127.0.0.1:10894

# === Server ===
HOST=0.0.0.0
PORT=10716
LOG_LEVEL=INFO

# === Camera stream defaults ===
TAPO_CAMERA_USE_HTTPS=true
TAPO_CAMERA_VERIFY_SSL=false
TAPO_CAMERA_TIMEOUT=10
TAPO_CAMERA_STREAM_TYPE=rtsp
TAPO_CAMERA_STREAM_QUALITY=high
TAPO_CAMERA_STREAM_AUDIO=true
TAPO_CAMERA_STORAGE_PATH=./recordings
TAPO_CAMERA_MAX_STORAGE_GB=10
TAPO_CAMERA_MOTION_DETECTION_ENABLED=true
TAPO_CAMERA_MOTION_SENSITIVITY=medium
TAPO_CAMERA_PTZ_SPEED=0.5
TAPO_MCP_SKIP_HARDWARE_INIT=false
TAPO_MCP_LAZY_INIT=false
TAPO_MCP_TOOL_MODE=production
DEVICES_MCP_AUTO_DISCOVER_USB=true

# === MCP Transport ===
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=10716

# === Optional integrations ===
# PLEX_URL=http://192.168.0.XXX:32400
# PLEX_TOKEN=your_plex_token
# OPENWEATHERMAP_API_KEY=your_api_key
