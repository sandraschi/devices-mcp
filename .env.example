# Devices MCP Environment Variables (EXAMPLE - copy to .env and fill in)
# MCP Server: Devices MCP (Unified IoT Hub)

# Server Configuration
HOST=0.0.0.0
PORT=10716
DEBUG=false
LOG_LEVEL=INFO

# Robotics Integration
DREAME_HOST=192.168.0.XXX
DREAME_TOKEN=your_token_here
YAHBOOM_HOST=192.168.0.XXX

# Camera 1
TAPO_CAMERA_HOST=192.168.0.XXX
TAPO_CAMERA_PORT=2020
TAPO_CAMERA_USERNAME=your_username
TAPO_CAMERA_PASSWORD=your_password

# Camera 2
TAPO_CAMERA_2_HOST=192.168.0.XXX
TAPO_CAMERA_2_PORT=2020
TAPO_CAMERA_2_USERNAME=your_username
TAPO_CAMERA_2_PASSWORD=your_password

# Lighting Devices
TAPO_L900_STRIP_HOST=192.168.0.XXX
TAPO_L900_STRIP_USERNAME=admin
TAPO_L900_STRIP_PASSWORD=your_secure_password

TAPO_CAMERA_USE_HTTPS=true
TAPO_CAMERA_VERIFY_SSL=false
TAPO_CAMERA_TIMEOUT=10

# Stream Settings
TAPO_CAMERA_STREAM_TYPE=rtsp
TAPO_CAMERA_STREAM_QUALITY=high
TAPO_CAMERA_STREAM_AUDIO=true

# Storage Settings
TAPO_CAMERA_STORAGE_PATH=./recordings
TAPO_CAMERA_MAX_STORAGE_GB=10

# Motion Detection
TAPO_CAMERA_MOTION_DETECTION_ENABLED=true
TAPO_CAMERA_MOTION_SENSITIVITY=medium

# PTZ Settings
TAPO_CAMERA_PTZ_SPEED=0.5

# Hardware Init
TAPO_MCP_SKIP_HARDWARE_INIT=false
TAPO_MCP_LAZY_INIT=false
TAPO_MCP_TOOL_MODE=production
DEVICES_MCP_AUTO_DISCOVER_USB=true

# MCP Transport
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=10716

# Plex (optional)
PLEX_URL=http://192.168.0.XXX:32400
PLEX_TOKEN=your_plex_token

# Home Assistant (optional)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your_ha_long_lived_token

# OpenWeatherMap (optional)
OPENWEATHERMAP_API_KEY=your_api_key
